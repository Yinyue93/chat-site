<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel - Glitch Chat</title>
  <link rel="stylesheet" href="/css/admin_panel.css"> <!-- Link to your CSS -->
</head>
<body>
  <div class="admin-container">
    <!-- Updated header with navigation -->
    <div class="admin-header">
      <h1>Admin Control Panel</h1>
      <div class="admin-nav">
        <a href="/main" class="back-btn">← Back to Main</a>
        <form action="/logout" method="POST" style="display: inline;">
          <button type="submit" class="logout-btn">Logout</button>
        </form>
      </div>
    </div>

    <!-- Users Section -->
    <section class="section">
      <h2>Connected Users (<span id="user-count"><%= users.length %></span>)</h2>
      <input type="text" id="user-search" class="search-box" placeholder="Search by Username or IP...">
      <table id="users-table">
        <thead>
          <tr>
            <th>Username</th>
            <th>IP Address</th>
            <th>Country</th>
            <th>Current Room</th>
            <th>Socket ID</th>
            <th>Admin?</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="users-tbody">
          <% users.forEach(user => { %>
            <tr data-username="<%= user.username.toLowerCase() %>" data-ip="<%= user.ipAddress %>">
              <td><%= user.username %></td>
              <td><%= user.ipAddress %></td>
              <td>
                <%= user.country %>
                <% if (user.country && user.country !== '?') { %>
                  <img src="https://flagsapi.com/<%= user.country %>/flat/24.png" alt="<%= user.country %>" class="flag-icon" title="<%= user.country %>">
                <% } %>
              </td>
              <td><%= user.roomName %> (<%= user.roomId || 'N/A' %>)</td>
              <td><%= user.socketId %></td>
              <td><%= user.isAdmin ? 'Yes' : 'No' %></td>
              <td>
                <% if (!user.isAdmin) { %> <!-- Don't allow kicking/banning other admins -->
                <button class="kick-btn" data-socket-id="<%= user.socketId %>">Kick</button>
                <button class="ban-btn" data-socket-id="<%= user.socketId %>" data-username="<%= user.username %>" data-ip="<%= user.ipAddress %>">Ban (IP)</button>
                <% } else { %>
                  (Admin)
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <!-- Rooms Section -->
    <section class="section">
      <h2>Active Rooms (<span id="room-count"><%= rooms.length %></span>)</h2>
      <input type="text" id="room-search" class="search-box" placeholder="Search by Room Name...">
      <table id="rooms-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>ID</th>
            <th>Users</th>
            <th>Max</th>
            <th>Hidden?</th>
            <th>User List</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="rooms-tbody">
          <% rooms.forEach(room => { %>
            <tr data-roomname="<%= room.name.toLowerCase() %>" class="<%= room.isHidden ? 'hidden-row' : '' %>">
              <td><%= room.name %></td>
              <td><%= room.id %></td>
              <td><%= room.userCount %></td>
              <td><%= room.maxUsers %></td>
              <td><%= room.isHidden ? 'Yes' : 'No' %></td>
              <td><%= room.users.join(', ') %></td>
              <td>
                <% if (room.isHidden) { %>
                  <button class="unhide-btn" data-room-id="<%= room.id %>">Unhide</button>
                <% } else { %>
                  <button class="hide-btn" data-room-id="<%= room.id %>">Hide</button>
                <% } %>
                <button class="delete-btn" data-room-id="<%= room.id %>">Delete</button>
                <a href="/admin/download-log/<%= room.id %>" target="_blank" class="action-link download-link">Download Log</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <!-- Bans Section -->
    <section class="section">
      <h2>Current Bans (<span id="ban-count"><%= bans.length %></span>)</h2>
      <% if (bans.length === 0) { %>
        <p>No active bans.</p>
      <% } else { %>
        <table id="bans-table">
          <thead>
            <tr>
              <th>Value</th>
              <th>Type</th>
              <th>Banned By</th>
              <th>Banned At</th>
              <th>Reason</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="bans-tbody">
            <% bans.forEach(ban => { %>
              <tr>
                <td><%= ban.value %></td>
                <td><%= ban.type %></td>
                <td><%= ban.bannedBy %></td>
                <td><%= new Date(ban.bannedAt).toLocaleString() %></td>
                <td><%= ban.reason || 'N/A' %></td>
                <td>
                  <button class="unban-btn" data-ban-value="<%= ban.value %>">Unban</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </section>

  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/admin.js"></script> <!-- Your client-side admin logic -->
  
  <script>
    // Add timezone offset to all download links on page load
    document.addEventListener('DOMContentLoaded', () => {
      const timezoneOffset = new Date().getTimezoneOffset();
      const downloadLinks = document.querySelectorAll('.download-link');
      
      downloadLinks.forEach(link => {
        const currentHref = link.getAttribute('href');
        if (currentHref && !currentHref.includes('?tz=')) {
          link.setAttribute('href', currentHref + '?tz=' + timezoneOffset);
        }
      });
    });
  </script>
</body>
</html>
